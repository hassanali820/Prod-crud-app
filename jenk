pipeline {
    agent any

    // Prevent multiple deployments from running together
    options {
        disableConcurrentBuilds()
        timestamps()
    }

    // Trigger pipeline when code is pushed to GitHub
    triggers {
        githubPush()
    }

    environment {
        DOCKERHUB_USER = 'hassanmehmood820'

        // Generate a unique version for every build
        APP_VERSION = "1.0.${BUILD_NUMBER}"

        FRONTEND_IMAGE = 'hassanmehmood820/crud-app-frontend'
        BACKEND_IMAGE  = 'hassanmehmood820/crud-app-backend'
    }

    stages {

        // Stage 1: Clone latest code from GitHub
        stage('Checkout') {
            steps {
                git branch: 'main',
                    credentialsId: 'github_cred',
                    url: 'https://github.com/hassanali820/Prod-crud-app.git'
            }
        }

        // Stage 2: Build frontend and backend Docker images
        stage('Build Docker Images') {
            steps {
                sh '''
                    # Build frontend image
                    docker build \
                    -t ${FRONTEND_IMAGE}:${APP_VERSION} ./frontend

                    # Build backend image
                    docker build \
                    -t ${BACKEND_IMAGE}:${APP_VERSION} ./backend
                '''
            }
        }

        // Stage 3: Add latest tag to both images
        stage('Tag Images') {
            steps {
                sh '''
                    docker tag ${FRONTEND_IMAGE}:${APP_VERSION} \
                    ${FRONTEND_IMAGE}:latest

                    docker tag ${BACKEND_IMAGE}:${APP_VERSION} \
                    ${BACKEND_IMAGE}:latest
                '''
            }
        }

        // Stage 4: Login to Docker Hub and push images
        stage('Push to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'docker_hub_cred',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh '''
                        # Login to Docker Hub
                        echo "$DOCKER_PASS" | docker login \
                        -u "$DOCKER_USER" --password-stdin

                        # Push versioned frontend image
                        docker push ${FRONTEND_IMAGE}:${APP_VERSION}

                        # Push latest frontend image
                        docker push ${FRONTEND_IMAGE}:latest

                        # Push versioned backend image
                        docker push ${BACKEND_IMAGE}:${APP_VERSION}

                        # Push latest backend image
                        docker push ${BACKEND_IMAGE}:latest
                    '''
                }
            }
        }

        // Stage 5: Deploy application on the same EC2
        stage('Deploy Application') {
            steps {
                // Get .env file securely from Jenkins Credentials
                withCredentials([
                    file(
                        credentialsId: 'backend_env',
                        variable: 'ENV_FILE'
                    )
                ]) {
                    sh '''
                        # Copy .env file into backend folder
                        cp "$ENV_FILE" backend/.env

                        # Automatically remove copied file after deployment
                        trap 'rm -f backend/.env' EXIT

                        # 1. Force remove all containers (DB, Backend, Frontend) to prevent any name conflicts
                        docker rm -f crud_db crud_backend crud_frontend || true

                        # 2. Stop and remove old compose networks/volumes
                        docker compose down --remove-orphans || true

                        # 3. Pull latest Docker images
                        docker compose pull

                        # 4. Start fresh application containers
                        docker compose up -d --remove-orphans
                    '''
                }
            }
        }
    }

    post {
        always {
            // Logout from Docker Hub
            sh 'docker logout || true'
        }

        success {
            echo "Build #${BUILD_NUMBER} deployed successfully!"
        }

        failure {
            echo "Build failed. Please check Jenkins console output."
        }
    }
}